# Copy this file to .env and fill in whichever providers you want to use.
# .env is gitignored — never commit real keys.
# Any subset can be left blank; unconfigured providers are skipped automatically.

ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Ollama Cloud (hosted models, needs an API key)
OLLAMA_API_KEY=

# Local Ollama (no key — set to 1 and run `ollama serve` locally)
OLLAMA_ENABLED=
